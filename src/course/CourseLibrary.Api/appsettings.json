{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cosmos": {
    "AccountEndpoint": "https://localhost:8081",
    "AccountKey": "YOUR_COSMOS_KEY",
    "DatabaseName": "CourseLibrary",
    "CoursesContainer": "Courses",
    "AuthorsContainer": "Authors",
    "CommentsContainer": "Comments",
    "DiscussionsContainer": "Discussions"
  },
  "Resilience": {
    "Http": {
      "Retry": {
        "BackoffType": "Exponential",
        "UseJitter": true,
        "MaxRetryAttempts": 7
      }
    }
  }
}
