<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Course Library</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-controller="Home" asp-action="Index">Course Library</a>
        <nav>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Home" asp-action="Search">Browse</a>
                <a asp-controller="Home" asp-action="Mine">My courses</a>
                <a asp-controller="Home" asp-action="Course">Courses</a>
                <span class="identity">@User.Identity.Name</span>
                <a asp-controller="Home" asp-action="Logout">Sign out</a>
            }
            else
            {
                <a asp-controller="Home" asp-action="Login">Sign in</a>
            }
        </nav>
    </header>
    <main class="page-shell">
        @RenderBody()
    </main>
</body>
</html>
