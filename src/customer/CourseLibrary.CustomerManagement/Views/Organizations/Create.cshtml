@model CreateOrganizationViewModel
<p class="eyebrow">NEW ORGANIZATION</p>
<h1>Create an organization</h1>
<p>Your account will become its Owner. The selected product is attached to this organization.</p>

@if (Model.ProductPlans.Count == 0)
{
    <div class="notice error">No active product plans are available. Contact your administrator to add a product and plan to the catalog.</div>
}
else
{
    <form asp-action="Create" method="post" class="card form-card">
        <div asp-validation-summary="ModelOnly" class="validation"></div>
        <label asp-for="Name">Organization name</label>
        <input asp-for="Name" autocomplete="organization" />
        <span asp-validation-for="Name" class="validation"></span>

        <label asp-for="ProductPlanId">Product and subscription plan</label>
        <select asp-for="ProductPlanId">
            <option value="">Select a product plan</option>
            @foreach (var plan in Model.ProductPlans)
            {
                <option value="@plan.Id">@plan.ProductName — @plan.PlanName</option>
            }
        </select>
        <span asp-validation-for="ProductPlanId" class="validation"></span>
        <p class="hint">This records the selected plan. Billing and payment processing are not part of this service.</p>

        <label>
            <input asp-for="GiveCreatorProductAccess" />
            Give me product access
        </label>

        <div class="form-actions">
            <a class="button secondary" asp-action="Index">Cancel</a>
            <button class="button primary" type="submit">Create organization</button>
        </div>
    </form>
}
