@model OrganizationDetailsViewModel
<p class="eyebrow">ORGANIZATION</p>
<div class="page-heading">
    <div>
        <h1>@Model.Name</h1>
        <p>You are an @Model.CurrentRole.ToLowerInvariant().</p>
    </div>
    @if (Model.CurrentRole is "Owner" or "Administrator")
    {
        <div class="form-actions">
            <a class="button secondary" asp-action="AddProduct" asp-route-id="@Model.Id">Add a product</a>
            <a class="button primary" asp-controller="Invitations" asp-action="Create" asp-route-organizationId="@Model.Id">Invite a teammate</a>
        </div>
    }
</div>

<div class="details-grid">
    <section class="card">
        <h2>Products and subscriptions</h2>
        @if (Model.Subscriptions.Count == 0)
        {
            <p>No product plan is selected.</p>
        }
        else
        {
            <ul class="plain-list">
                @foreach (var subscription in Model.Subscriptions)
                {
                    <li><strong>@subscription.ProductName</strong> — @subscription.PlanName <span class="status">@subscription.Status</span></li>
                }
            </ul>
        }
        <p class="hint">Product access is assigned to members separately. Billing and payment are handled separately.</p>
    </section>
    <section class="card">
        <h2>Members (@Model.Members.Count)</h2>
        <ul class="plain-list">
            @foreach (var member in Model.Members)
            {
                <li>
                    <span>
                        <strong>@member.Email</strong>
                        <span class="status">@member.Role</span>
                        <br />
                        <span class="status">
                            @(member.Products.Count == 0 ? "No product access" : string.Join(", ", member.Products))
                        </span>
                    </span>
                    @if (Model.CanManage)
                    {
                        <a asp-action="ManageProductAccess" asp-route-id="@Model.Id" asp-route-userId="@member.UserId">Manage access</a>
                    }
                </li>
            }
        </ul>
    </section>
</div>
<p><a asp-action="Index">Switch organization</a></p>
