{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Authentication": {
    "Jwt": {
      "Authority": "https://your-jwt-authority",
      "Audience": "course-library-api"
    },
    "M2M": {
      "Authority": "https://your-m2m-authority",
      "Audience": "course-library-api"
    }
  },
    "Cors": {
      "DefaultPolicy": "DefaultPolicy",
      "Policies": {
        "DefaultPolicy": {
          "AllowedOrigins": [
            "https://localhost:7019",
            "http://localhost:5120",
            "https://courselibrary-api-courselibrary.dev.localhost:7060"
          ],
          "AllowedMethods": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "OPTIONS"
          ],
          "AllowedHeaders": [
            "Content-Type",
            "Authorization",
            "X-Requested-With",
            "Accept",
            "Origin",
            "Cache-Control",
            "If-None-Match",
            "If-Modified-Since",
            "X-Correlation-ID"
          ],
          "ExposedHeaders": [
            "X-Custom-Header",
            "X-Correlation-ID",
            "Retry-After",
            "ETag",
            "Last-Modified",
            "Cache-Control",
            "Expires",
            "X-RateLimit-Limit",
            "X-RateLimit-Remaining",
            "X-RateLimit-Reset"
          ],
          "AllowCredentials": true,
          "MaxAge": 3600
        },

        "PublicApiPolicy": {
          "AllowedOrigins": [
            "*"
          ],
          "AllowedMethods": [
            "GET"
          ],
          "AllowedHeaders": [
            "Content-Type"
          ],
          "AllowCredentials": false
        },

        "InternalPolicy": {
          "AllowedOrigins": [
            "https://courselibrary-api-courselibrary.dev.localhost:7060"
          ],
          "AllowedMethods": [
            "*"
          ],
          "AllowedHeaders": [
            "*"
          ],
          "AllowCredentials": true
        }
      }
    },

    "ReverseProxy": {
      "Routes": {
        "test-log": {
          "ClusterId": "course-api",
          "CorsPolicy": "DefaultPolicy",
          "AuthorizationPolicy": "anonymous",
          "Match": { "Path": "/test-log" }
        },
        "course-api": {
          "ClusterId": "course-api",
          "CorsPolicy": "DefaultPolicy",
          "Match": {
            "Path": "/api/courses/{**catch-all}"
          }
        },

        "public-api": {
          "ClusterId": "public-api",
          "CorsPolicy": "PublicApiPolicy",
          "Match": {
            "Path": "/api/public/{**catch-all}"
          }
        },

        "internal-api": {
          "ClusterId": "internal-api",
          "CorsPolicy": "InternalPolicy",
          "Match": {
            "Path": "/api/internal/{**catch-all}"
          }
        }
      },

      "Clusters": {
        "course-api": {
          "Destinations": {
            "destination1": {
              "Address": "https+http://courselibrary-api/"
            }
          }
        },

        "public-api": {
          "Destinations": {
            "destination1": {
              "Address": "https+http://public-api/"
            }
          }
        },

        "internal-api": {
          "Destinations": {
            "destination1": {
              "Address": "https+http://internal-api/"
            }
          }
        }
      }
    }
  }
