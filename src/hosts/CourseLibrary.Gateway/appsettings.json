{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Jwt": {
      "Authority": "https://your-jwt-authority",
      "Audience": "course-library-api"
    },
    "M2M": {
      "Authority": "https://your-m2m-authority",
      "Audience": "course-library-api"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7019",
      "http://localhost:5120"
    ]
  },
  "Observability": {
    "Enabled": true
  },
  "ReverseProxy": {
    "Routes": {
      "test-log": {
        "ClusterId": "course-api",
        "Match": { "Path": "/test-log" }
      },
      "course-api": {
        "ClusterId": "course-api",
        "Match": {
          "Path": "/api/courses/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "course-api": {
        "Destinations": {
          "destination1": {
            "Address": "https+http://courselibrary-api/"
          }
        }
      }
    }
  }
}
