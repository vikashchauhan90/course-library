@model RecoveryCodeViewModel
<div class="auth-shell"><div class="card auth-card"><div class="card-body"><h1 class="h2">Use a recovery code</h1><p class="text-secondary">Enter one of the recovery codes saved when you enabled two-factor authentication.</p><form method="post"><input name="returnUrl" value="@ViewData["ReturnUrl"]" type="hidden" /><div asp-validation-summary="ModelOnly" class="mb-3"></div><div class="mb-4"><label asp-for="Code" class="form-label"></label><input asp-for="Code" class="form-control" autocomplete="one-time-code" /></div><button class="btn btn-primary w-100" type="submit">Sign in</button></form></div></div></div>
