@model List<ExternalLoginItem>
<div class="page-section"><div class="row justify-content-center"><div class="col-lg-7"><div class="card border-0 shadow-sm"><div class="card-body p-4"><h1 class="h3">External logins</h1><p class="text-secondary">Manage the providers connected to your Course Library account.</p><div class="list-group list-group-flush">@foreach (var login in Model) { <div class="list-group-item px-0 d-flex justify-content-between align-items-center"><span class="fw-semibold">@login.ProviderDisplayName</span><form asp-action="UnlinkExternalLogin" method="post" class="m-0"><input name="provider" value="@login.LoginProvider" type="hidden" /><input name="key" value="@login.ProviderKey" type="hidden" /><button class="btn btn-sm btn-outline-danger" type="submit">Unlink</button></form></div> }</div><div class="alert alert-light border mt-4 mb-0">To link a new provider, sign in with it from the login page.</div></div></div></div></div></div>
