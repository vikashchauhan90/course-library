@model ProfileViewModel
<div class="page-section"><div class="d-flex justify-content-between align-items-center mb-4"><div><div class="text-primary fw-semibold small text-uppercase">Account</div><h1 class="mb-1">Your profile</h1><p class="text-secondary mb-0">Manage your details and security preferences.</p></div></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> } @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="row g-4">
<div class="col-lg-7"><div class="card border-0 shadow-sm"><div class="card-body p-4"><h2 class="h5">Personal details</h2><form method="post"><div class="mb-3"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" class="form-control" /></div><input asp-for="Email" type="hidden" /><button class="btn btn-primary" type="submit">Save changes</button></form></div></div>
<div class="card border-0 shadow-sm mt-4"><div class="card-body p-4"><h2 class="h5">Change email</h2><p class="text-secondary small">A confirmation link will be sent to the new address.</p><form asp-action="ChangeEmail" method="post"><div class="mb-3"><label class="form-label" for="NewEmail">New email</label><input class="form-control" id="NewEmail" name="NewEmail" type="email" /></div><div class="mb-3"><label class="form-label" for="EmailPassword">Current password</label><input class="form-control" id="EmailPassword" name="Password" type="password" autocomplete="current-password" /></div><button class="btn btn-outline-primary" type="submit">Change email</button></form></div></div></div>
<div class="col-lg-5"><div class="card border-0 shadow-sm"><div class="card-body p-4"><h2 class="h5">Security</h2><div class="list-group list-group-flush"><a class="list-group-item list-group-item-action px-0" asp-action="ChangePassword">Change password <span class="float-end">&rsaquo;</span></a><a class="list-group-item list-group-item-action px-0" asp-action="ExternalLogins">External logins <span class="float-end">&rsaquo;</span></a><a class="list-group-item list-group-item-action px-0" asp-action="EnableAuthenticator">Two-factor authentication <span class="float-end">&rsaquo;</span></a></div><div class="d-grid gap-2 mt-4"><form asp-action="DisableTwoFactor" method="post"><button class="btn btn-outline-secondary w-100" type="submit">Disable 2FA</button></form><form asp-action="RegenerateRecoveryCodes" method="post"><button class="btn btn-outline-secondary w-100" type="submit">Regenerate recovery codes</button></form></div></div></div>
<div class="card border-danger mt-4"><div class="card-body p-4"><h2 class="h5 text-danger">Deactivate account</h2><p class="small text-secondary">This will sign you out and prevent further access.</p><form asp-action="DeleteAccount" method="post"><input class="form-control" name="Password" type="password" autocomplete="current-password" placeholder="Current password" /><button class="btn btn-danger mt-3" type="submit">Deactivate account</button></form></div></div></div></div></div>
