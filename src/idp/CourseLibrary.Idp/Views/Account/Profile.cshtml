@model ProfileViewModel
<h1>Profile</h1><div asp-validation-summary="ModelOnly"></div><form method="post"><label asp-for="FullName"></label><input asp-for="FullName" /><input asp-for="Email" type="hidden" /><button type="submit">Save profile</button></form><h2>Change email</h2><form asp-action="ChangeEmail" method="post"><label asp-for="Email">New email</label><input asp-for="Email" name="NewEmail" /><input name="Password" type="password" autocomplete="current-password" placeholder="Current password" /><button type="submit">Change email</button></form><p><a asp-action="ChangePassword">Change password</a> | <a asp-action="ExternalLogins">External logins</a> | <a asp-action="EnableAuthenticator">Two-factor authentication</a></p><form asp-action="DisableTwoFactor" method="post"><button type="submit">Disable 2FA</button></form><form asp-action="RegenerateRecoveryCodes" method="post"><button type="submit">Regenerate recovery codes</button></form><h2>Deactivate account</h2><form asp-action="DeleteAccount" method="post"><input name="Password" type="password" autocomplete="current-password" /><button type="submit">Deactivate account</button></form>
