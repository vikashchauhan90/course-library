@model ResetPasswordViewModel
<h1>Reset password</h1><form method="post"><div asp-validation-summary="ModelOnly"></div><input asp-for="Email" type="hidden" /><input asp-for="Token" type="hidden" /><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><button type="submit">Reset password</button></form>
