@model RegisterViewModel
<h1>Create account</h1><form method="post"><div asp-validation-summary="ModelOnly"></div><label asp-for="FullName"></label><input asp-for="FullName" /><label asp-for="Email"></label><input asp-for="Email" autocomplete="email" /><label asp-for="Password"></label><input asp-for="Password" autocomplete="new-password" /><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><button type="submit">Register</button></form>
