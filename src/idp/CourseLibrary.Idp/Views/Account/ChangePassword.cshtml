@model ChangePasswordViewModel
<h1>Change password</h1><form method="post"><div asp-validation-summary="ModelOnly"></div><label asp-for="CurrentPassword"></label><input asp-for="CurrentPassword" autocomplete="current-password" /><label asp-for="NewPassword"></label><input asp-for="NewPassword" autocomplete="new-password" /><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" autocomplete="new-password" /><button type="submit">Change password</button></form>
