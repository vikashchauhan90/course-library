@model VerifyAuthenticatorViewModel
<div class="auth-shell"><div class="card auth-card"><div class="card-body"><div class="text-center mb-4"><div class="text-primary fw-semibold small text-uppercase">Security check</div><h1 class="h2 mt-2">Verify your sign-in</h1><p class="text-secondary mb-0">Enter the code from your authenticator app.</p></div><form method="post"><input name="returnUrl" value="@ViewData["ReturnUrl"]" type="hidden" /><input name="rememberMe" value="@ViewData["RememberMe"]" type="hidden" /><div asp-validation-summary="ModelOnly" class="mb-3"></div><div class="mb-3"><label asp-for="Code" class="form-label">Authenticator code</label><input asp-for="Code" class="form-control text-center fs-4" autocomplete="one-time-code" inputmode="numeric" /></div><div class="form-check mb-4"><input asp-for="RememberMachine" class="form-check-input" /><label asp-for="RememberMachine" class="form-check-label">Remember this device</label></div><button class="btn btn-primary w-100" type="submit">Verify code</button></form><div class="text-center mt-4"><a asp-action="LoginWithRecoveryCode" asp-route-returnUrl="@ViewData["ReturnUrl"]">Use a recovery code</a></div></div></div></div>
