@model VerifyAuthenticatorViewModel
<h1>Two-factor authentication</h1><form method="post"><input name="returnUrl" value="@ViewData["ReturnUrl"]" type="hidden" /><input name="rememberMe" value="@ViewData["RememberMe"]" type="hidden" /><div asp-validation-summary="ModelOnly"></div><label asp-for="Code">Authenticator code</label><input asp-for="Code" autocomplete="one-time-code" /><label><input asp-for="RememberMachine" /> Remember this device</label><button type="submit">Verify</button></form><a asp-action="LoginWithRecoveryCode" asp-route-returnUrl="@ViewData["ReturnUrl"]">Use a recovery code</a>
