@model LoginViewModel
<div class="auth-shell">
<div class="card auth-card"><div class="card-body">
    <div class="text-center mb-4"><div class="text-primary fw-semibold small text-uppercase">Course Library</div><h1 class="h2 mt-2">Welcome back</h1><p class="text-secondary mb-0">Sign in to continue to your learning space.</p></div>
    <form asp-action="Login" method="post">
        <input asp-for="ReturnUrl" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="mb-3"></div>
        <div class="mb-3"><label asp-for="UserName" class="form-label"></label><input asp-for="UserName" class="form-control" autocomplete="username" /></div>
        <div class="mb-3"><label asp-for="Password" class="form-label"></label><input asp-for="Password" class="form-control" autocomplete="current-password" /></div>
        <div class="d-flex justify-content-between align-items-center mb-3"><div class="form-check"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label">Remember me</label></div><a asp-action="ForgotPassword" class="small">Forgot password?</a></div>
        <button class="btn btn-primary w-100" type="submit">Sign in</button>
    </form>
    <div class="text-center mt-4 pt-3 border-top"><span class="text-secondary">New to Course Library?</span> <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl" class="fw-semibold">Create an account</a></div>
</div></div>
</div>
@inject Microsoft.AspNetCore.Authentication.IAuthenticationSchemeProvider SchemeProvider
@{
    var externalProviders = (await SchemeProvider.GetAllSchemesAsync()).Where(x => x.DisplayName is not null).ToList();
}
@if (externalProviders.Count > 0)
{
    <div class="auth-shell pt-0"><div class="card auth-card"><div class="card-body"><h2 class="h5">Or sign in with</h2>
    @foreach (var provider in externalProviders)
    {
        <form asp-action="ExternalLogin" method="post"><input name="provider" type="hidden" value="@provider.Name" /><input name="returnUrl" type="hidden" value="@Model.ReturnUrl" /><button class="btn btn-outline-secondary w-100" type="submit">Continue with @provider.DisplayName</button></form>
    }
    </div></div></div>
}
