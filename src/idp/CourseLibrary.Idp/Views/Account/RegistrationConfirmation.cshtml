@model EmailViewModel
<div class="auth-shell"><div class="card auth-card"><div class="card-body text-center"><div class="display-6 text-primary mb-3">&#10003;</div><h1 class="h2">Check your email</h1><p class="text-secondary">If the address belongs to an account that still needs confirmation, we sent a confirmation link. Open it to finish activating your account.</p><div asp-validation-summary="ModelOnly" class="mb-3 text-start"></div><form asp-action="ResendConfirmation" method="post"><input asp-for="ReturnUrl" type="hidden" /><div class="mb-3 text-start"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" /></div><button class="btn btn-outline-primary" type="submit">Resend confirmation email</button></form><a class="btn btn-link mt-2" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Back to sign in</a></div></div></div>
