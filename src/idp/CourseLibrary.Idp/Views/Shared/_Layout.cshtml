<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>@ViewData["Title"] - Course Library</title>
	<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<nav class="navbar navbar-expand-lg bg-white border-bottom shadow-sm">
	<div class="container">
		<a class="navbar-brand fw-bold text-primary" asp-controller="Home" asp-action="Index">Course Library</a>
		<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
		<div class="collapse navbar-collapse" id="mainNav">
			<div class="navbar-nav me-auto">
				@if (User.IsInRole("Administrator")) { <a class="nav-link" asp-controller="Admin" asp-action="Index">Administration</a> }
				@if (User.Identity?.IsAuthenticated == true) { <a class="nav-link" asp-controller="Account" asp-action="Profile">Profile</a> }
			</div>
			<div class="d-flex align-items-center gap-3">
				@if (User.Identity?.IsAuthenticated == true)
				{
					<span class="small text-secondary">Signed in as @User.Identity.Name</span>
					<form asp-controller="Account" asp-action="Logout" method="post" class="m-0"><button class="btn btn-outline-secondary btn-sm" type="submit">Sign out</button></form>
				}
				else
				{
					<a class="btn btn-outline-primary btn-sm" asp-controller="Account" asp-action="Login">Sign in</a>
					<a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Create account</a>
				}
			</div>
		</div>
	</div>
</nav>
<main>@RenderBody()</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
