@model AdminClientsViewModel
<div class="admin-shell"><div class="admin-heading"><div><div class="eyebrow">OpenID Connect</div><h1>OAuth clients</h1><p>Manage applications, service identities, audiences, and credentials.</p></div><a class="btn btn-primary" asp-action="CreateClient">Register client</a></div><div class="admin-toolbar"><a asp-action="Index">Overview</a><a asp-action="Users">Users</a><a asp-action="Roles">Roles</a><span>OAuth clients</span><a asp-action="Scopes">API scopes</a></div><div class="admin-panel"><div class="panel-header"><div><h2>Registered applications</h2><p>Secrets are shown only once when created or rotated.</p></div></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Client</th><th>Allowed scopes / audiences</th><th>Created</th><th>Secret lifecycle</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach (var client in Model.Clients) { <tr><td><strong>@client.DisplayName</strong><small class="d-block font-monospace text-secondary">@client.ClientId</small></td><td><span class="resource-tag">@(string.IsNullOrWhiteSpace(client.AllowedScopes) ? "None" : client.AllowedScopes)</span></td><td>@client.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd")</td><td><small class="d-block">Created: @(client.SecretCreatedAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "Legacy")</small><small class="d-block">Rotated: @(client.SecretRotatedAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "Never")</small><span class="status-pill @(client.IsSecretExpired ? "status-danger" : "status-success")">Expires @(client.SecretExpiresAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "Not set")</span></td><td class="text-end"><form asp-action="RotateClientSecret" asp-route-clientId="@client.ClientId" method="post" class="m-0"><button class="btn btn-sm btn-outline-primary" type="submit">Rotate secret</button></form></td></tr>}</tbody></table></div></div></div>