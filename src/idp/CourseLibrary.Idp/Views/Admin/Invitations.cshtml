@model AdminInvitationsViewModel
<div class="admin-shell">
	<div class="admin-heading">
		<div><div class="eyebrow">Directory</div><h1>Invitations</h1><p>Track pending, accepted, expired, and revoked account invitations.</p></div>
		<div class="admin-actions"><a class="btn btn-outline-primary" asp-action="Users">User directory</a><a class="btn btn-primary" asp-action="InviteUser">Invite user</a></div>
	</div>
	<div class="admin-toolbar"><a asp-action="Index">Overview</a><a asp-action="Users">Users</a><span>Invitations</span><a asp-action="Roles">Roles</a><a asp-action="Clients">OAuth clients</a><a asp-action="Scopes">API scopes</a></div>
	@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
	@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
	<div class="admin-panel">
		<div class="panel-header"><div><h2>Invitation history</h2><p>@Model.Invitations.Count invitation(s)</p></div></div>
		<div class="table-responsive"><table class="table align-middle mb-0">
			<thead><tr><th>User</th><th>Created</th><th>Expires</th><th>Accepted</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
			<tbody>
			@foreach (var invitation in Model.Invitations)
			{
				<tr>
					<td><strong>@invitation.FullName</strong><small class="d-block text-secondary">@invitation.Email</small></td>
					<td>@invitation.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
					<td>@invitation.ExpiresAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
					<td>@(invitation.AcceptedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
					<td><span class="status-pill @(invitation.Status == "Pending" || invitation.Status == "Accepted" ? "status-success" : "status-danger")">@invitation.Status</span></td>
					<td class="text-end">
						@if (invitation.CanResend)
						{
							<form asp-action="ResendInvitation" asp-route-id="@invitation.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-primary" type="submit">Resend</button></form>
						}
						@if (invitation.CanRevoke)
						{
							<form asp-action="RevokeInvitation" asp-route-id="@invitation.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger" type="submit">Revoke</button></form>
						}
						@if (!invitation.CanResend && !invitation.CanRevoke)
						{
							<span class="text-secondary">—</span>
						}
					</td>
				</tr>
			}
			@if (Model.Invitations.Count == 0)
			{
				<tr><td colspan="6" class="text-center text-secondary py-4">No invitations found.</td></tr>
			}
			</tbody>
		</table></div>
	</div>
</div>
