@model AdminUsersViewModel
@{
	var pageCount = Math.Max(1, (int)Math.Ceiling(Model.TotalCount / (double)Model.PageSize));
}
<div class="admin-shell">
	<div class="admin-heading">
		<div><div class="eyebrow">Directory</div><h1>Users</h1><p>Manage identities, roles, sessions, and account status.</p></div>
		<div class="admin-actions"><a class="btn btn-outline-primary" asp-action="Invitations">Invitation history</a><a class="btn btn-outline-primary" asp-action="InviteUser">Invite user</a><a class="btn btn-primary" asp-action="CreateUser">Create user</a></div>
	</div>
	<div class="admin-toolbar"><a asp-action="Index">Overview</a><span>Users</span><a asp-action="Roles">Roles</a><a asp-action="Clients">OAuth clients</a><a asp-action="Scopes">API scopes</a></div>
	@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
	@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
	<div class="admin-panel">
		<div class="panel-header"><div><h2>Directory</h2><p>@Model.TotalCount account(s) in this view; @Model.ActiveCount active and @Model.InactiveCount inactive.</p></div></div>
		<div class="admin-toolbar m-3">
			<a asp-action="Users" asp-route-status="all">All (@(Model.ActiveCount + Model.InactiveCount))</a>
			<a asp-action="Users" asp-route-status="active">Active (@Model.ActiveCount)</a>
			<a asp-action="Users" asp-route-status="inactive">Inactive (@Model.InactiveCount)</a>
		</div>
		<div class="table-responsive"><table class="table align-middle mb-0">
			<thead><tr><th>User</th><th>Email</th><th>Admin</th><th>Status</th><th>Last login</th><th>Password changed</th><th class="text-end">Actions</th></tr></thead>
			<tbody>
			@foreach (var user in Model.Users)
			{
				<tr>
					<td><strong>@user.UserName</strong></td>
					<td>@user.Email</td>
					<td>@(user.IsAdministrator ? "Yes" : "No")</td>
					<td><span class="status-pill @(user.Status == "Active" ? "status-success" : "status-danger")">@user.Status</span></td>
					<td>@(user.LastLoginAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "Never")</td>
					<td>@(user.PasswordChangedAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "Not recorded")</td>
					<td class="text-end">
						@if (!user.IsDeactivated)
						{
							<a class="btn btn-sm btn-outline-primary" asp-action="EditUser" asp-route-id="@user.Id">Manage</a>
							<form asp-action="ToggleUserLock" asp-route-id="@user.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary" type="submit">@(user.IsLockedOut ? "Unlock" : "Lock")</button></form>
							@if (user.CanSendPasswordReset)
							{
								<form asp-action="SendUserPasswordReset" asp-route-id="@user.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-warning" type="submit">Send reset link</button></form>
							}
						}
						else
						{
							<span class="text-secondary">No actions</span>
						}
					</td>
				</tr>
			}
			@if (Model.Users.Count == 0)
			{
				<tr><td colspan="7" class="text-center text-secondary py-4">No accounts in this view.</td></tr>
			}
			</tbody>
		</table></div>
		@if (pageCount > 1)
		{
			<div class="d-flex justify-content-between align-items-center p-3">
				<span class="small text-secondary">Page @Model.Page of @pageCount</span>
				<div class="d-flex gap-2">
					@if (Model.Page > 1) { <a class="btn btn-sm btn-outline-secondary" asp-action="Users" asp-route-status="@Model.Status" asp-route-page="@(Model.Page - 1)">Previous</a> }
					@if (Model.Page < pageCount) { <a class="btn btn-sm btn-outline-secondary" asp-action="Users" asp-route-status="@Model.Status" asp-route-page="@(Model.Page + 1)">Next</a> }
				</div>
			</div>
		}
	</div>
</div>
