@model AdminUsersViewModel
<div class="admin-shell"><div class="admin-heading"><div><div class="eyebrow">Directory</div><h1>Users</h1><p>Manage identities, roles, sessions, and account status.</p></div><div class="admin-actions"><a class="btn btn-outline-primary" asp-action="InviteUser">Invite user</a><a class="btn btn-primary" asp-action="CreateUser">Create user</a></div></div><div class="admin-toolbar"><a asp-action="Index">Overview</a><span>Users</span><a asp-action="Roles">Roles</a><a asp-action="Clients">OAuth clients</a><a asp-action="Scopes">API scopes</a></div><div class="admin-panel"><div class="panel-header"><div><h2>Directory</h2><p>@Model.Users.Count account(s)</p></div></div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>User</th><th>Email</th><th>Admin</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach (var user in Model.Users) { <tr><td><strong>@user.UserName</strong></td><td>@user.Email</td><td>@(user.IsAdministrator ? "Yes" : "No")</td><td><span class="status-pill @(user.IsLockedOut ? "status-danger" : "status-success")">@(user.IsLockedOut ? "Locked" : "Active")</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="EditUser" asp-route-id="@user.Id">Manage</a> <form asp-action="ToggleUserLock" asp-route-id="@user.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary" type="submit">@(user.IsLockedOut ? "Unlock" : "Lock")</button></form></td></tr>}</tbody></table></div></div></div>