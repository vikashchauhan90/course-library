@model AdminIndexViewModel
<div class="page-section"><div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><div class="text-primary fw-semibold small text-uppercase">Control center</div><h1 class="mb-1">Identity administration</h1><p class="text-secondary mb-0">Manage users, applications, and permissions.</p></div><a class="btn btn-primary" asp-action="InviteUser">Invite user</a></div>
@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> } @if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
@if (TempData["ClientSecret"] is string secret) { <div class="alert alert-warning"><strong>Copy the client secret now.</strong><div class="font-monospace text-break mt-2">@secret</div><small>It will not be shown again.</small></div> }
@if (TempData["InvitationLink"] is string invitationLink) { <div class="alert alert-info"><strong>Copy the invitation link now.</strong><div class="font-monospace text-break mt-2">@invitationLink</div><small>It will not be shown again.</small></div> }
<div class="card border-0 shadow-sm mb-4"><div class="card-body p-0"><div class="d-flex justify-content-between align-items-center p-4"><div><h2 class="h5 mb-1">Users</h2><p class="text-secondary small mb-0">Accounts and administrator access</p></div><a class="btn btn-outline-primary btn-sm" asp-action="CreateUser">Create user</a></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th class="ps-4">Username</th><th>Email</th><th>Administrator</th><th>Status</th><th class="text-end pe-4">Action</th></tr></thead><tbody>@foreach (var user in Model.Users) { <tr><td class="ps-4 fw-semibold">@user.UserName</td><td>@user.Email</td><td>@(user.IsAdministrator ? "Yes" : "No")</td><td><span class="badge rounded-pill @(user.IsLockedOut ? "text-bg-danger" : "text-bg-success")">@(user.IsLockedOut ? "Locked" : "Active")</span></td><td class="text-end pe-4"><form asp-action="ToggleUserLock" asp-route-id="@user.Id" method="post" class="m-0"><button class="btn btn-sm btn-outline-secondary" type="submit">@(user.IsLockedOut ? "Unlock" : "Lock")</button></form></td></tr> }</tbody></table></div></div></div>
<div class="row g-4"><div class="col-lg-7"><div class="card border-0 shadow-sm h-100"><div class="d-flex justify-content-between align-items-center p-4"><div><h2 class="h5 mb-1">OAuth clients</h2><p class="text-secondary small mb-0">Registered applications</p></div><a class="btn btn-outline-primary btn-sm" asp-action="CreateClient">Create client</a></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th class="ps-4">Client ID</th><th>Name</th><th class="text-end pe-4">Action</th></tr></thead><tbody>@foreach (var client in Model.Clients) { <tr><td class="ps-4 font-monospace small">@client.ClientId</td><td>@client.DisplayName</td><td class="text-end pe-4"><form asp-action="RotateClientSecret" asp-route-clientId="@client.ClientId" method="post" class="m-0"><button class="btn btn-sm btn-outline-secondary" type="submit">Rotate secret</button></form></td></tr> }</tbody></table></div></div></div>
<div class="col-lg-5"><div class="card border-0 shadow-sm h-100"><div class="d-flex justify-content-between align-items-center p-4"><div><h2 class="h5 mb-1">Scopes</h2><p class="text-secondary small mb-0">API permissions</p></div><a class="btn btn-outline-primary btn-sm" asp-action="CreateScope">Create scope</a></div><div class="list-group list-group-flush">@foreach (var scope in Model.Scopes) { <div class="list-group-item px-4"><div class="fw-semibold">@scope.DisplayName</div><div class="small text-secondary font-monospace">@scope.Name</div><div class="small text-secondary">@scope.Resources</div></div> }</div></div></div></div></div>
