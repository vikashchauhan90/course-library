@model AdminOverviewViewModel
<div class="admin-shell">
	<div class="admin-heading"><div><div class="eyebrow">Identity platform</div><h1>Administration</h1><p>Manage people, access, and OAuth services from one place.</p></div><span class="environment-chip">Control center</span></div>
	@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
	@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
	@if (TempData["ClientSecret"] is string secret) { <div class="alert alert-warning"><strong>Copy this client secret now.</strong><div class="font-monospace text-break mt-2">@secret</div><small>It will not be shown again.</small></div> }
	@if (TempData["InvitationLink"] is string invitationLink) { <div class="alert alert-info"><strong>Copy this invitation link now.</strong><div class="font-monospace text-break mt-2">@invitationLink</div></div> }
	<div class="admin-stat-grid"><a class="admin-stat" asp-action="Users"><span>Users</span><strong>@Model.UserCount</strong><small>Accounts and access</small></a><a class="admin-stat" asp-action="Roles"><span>Roles</span><strong>@Model.RoleCount</strong><small>Permission bundles</small></a><a class="admin-stat" asp-action="Clients"><span>OAuth clients</span><strong>@Model.ClientCount</strong><small>Applications and secrets</small></a><a class="admin-stat" asp-action="Scopes"><span>API scopes</span><strong>@Model.ScopeCount</strong><small>Protected resources</small></a></div>
	<div class="admin-section-grid"><a class="admin-section-link" asp-action="Users"><span class="section-icon">01</span><span><strong>User management</strong><small>Create users, invite people, assign roles, lock accounts, and revoke sessions.</small></span><span class="section-arrow">&#8594;</span></a><a class="admin-section-link" asp-action="Roles"><span class="section-icon">02</span><span><strong>Roles &amp; permissions</strong><small>Build access bundles and map resource actions to each role.</small></span><span class="section-arrow">&#8594;</span></a><a class="admin-section-link" asp-action="Clients"><span class="section-icon">03</span><span><strong>OAuth clients</strong><small>Manage services, PKCE applications, credentials, rotation, and expiry.</small></span><span class="section-arrow">&#8594;</span></a><a class="admin-section-link" asp-action="Scopes"><span class="section-icon">04</span><span><strong>API scopes</strong><small>Define the APIs and resources that clients may request.</small></span><span class="section-arrow">&#8594;</span></a></div>
</div>
