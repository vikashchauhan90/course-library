@model AdminScopesViewModel
<div class="admin-shell"><div class="admin-heading"><div><div class="eyebrow">Resource servers</div><h1>API scopes</h1><p>Define the APIs and resources that clients can request.</p></div><a class="btn btn-primary" asp-action="CreateScope">Create scope</a></div><div class="admin-toolbar"><a asp-action="Index">Overview</a><a asp-action="Users">Users</a><a asp-action="Roles">Roles</a><a asp-action="Clients">OAuth clients</a><span>API scopes</span></div><div class="admin-panel"><div class="panel-header"><div><h2>Registered scopes</h2><p>Scopes are the consentable permissions exposed to OAuth clients.</p></div></div><div class="scope-list">@foreach (var scope in Model.Scopes) { <div class="scope-row"><div><strong>@scope.DisplayName</strong><small class="d-block font-monospace">@scope.Name</small></div><span class="resource-tag">@scope.Resources</span><form asp-action="DeleteScope" asp-route-name="@scope.Name" method="post" class="ms-auto"><button class="btn btn-sm btn-outline-danger" type="submit">Delete</button></form></div>}</div></div></div>