@model CreateClientViewModel
<div class="admin-shell"><div class="admin-heading"><div><div class="eyebrow">OpenID Connect</div><h1>Register client</h1><p>Create a browser application or a machine-to-machine service identity.</p></div><a class="btn btn-outline-secondary" asp-action="Clients">Cancel</a></div><div class="admin-panel form-panel"><div class="panel-header"><div><h2>Client registration</h2><p>Secrets are shown once. Store them in a secure secret manager.</p></div></div><form method="post" class="admin-form"><div asp-validation-summary="ModelOnly"></div><label asp-for="DisplayName">Display name</label><input asp-for="DisplayName" placeholder="Course ingestion service" /><div class="client-type-grid"><label class="client-type"><input asp-for="IsMachineClient" /> <span><strong>Machine client</strong><small>Client credentials for service-to-service calls. Client ID is generated automatically.</small></span></label><label class="client-type"><input asp-for="AllowAuthorizationCode" /> <span><strong>Browser application</strong><small>Authorization code with PKCE for interactive users.</small></span></label></div><div id="client-id-field"><label asp-for="ClientId">Client ID</label><input asp-for="ClientId" placeholder="course-library-app" /></div><div id="redirect-uri-field"><label asp-for="RedirectUri">Redirect URI</label><input asp-for="RedirectUri" placeholder="https://app.example.com/signin-oidc" /></div><fieldset><legend>Allowed audiences</legend><p class="form-help">Scopes control which APIs this client may request. Their resource values become the token audience.</p>@foreach (var scope in Model.AvailableScopes) { <label class="scope-option"><input type="checkbox" name="AllowedScopes" value="@scope.Name" @(Model.AllowedScopes.Contains(scope.Name, StringComparer.OrdinalIgnoreCase) ? "checked" : null) /><span><strong>@scope.DisplayName</strong><small class="font-monospace">@scope.Name · @scope.Resources</small></span></label> }</fieldset><button class="btn btn-primary" type="submit">Register client</button></form></div></div><script>const machine = document.getElementById('IsMachineClient'); const id = document.getElementById('client-id-field'); const redirect = document.getElementById('redirect-uri-field'); function update() { id.hidden = machine.checked; redirect.hidden = machine.checked; } machine.addEventListener('change', update); update();</script>
