@model AdminRolesViewModel
<div class="admin-shell"><div class="admin-heading"><div><div class="eyebrow">Authorization</div><h1>Roles &amp; permissions</h1><p>Assign reusable access bundles to users and services.</p></div><a class="btn btn-primary" asp-action="CreateRole">Create role</a></div><div class="admin-toolbar"><a asp-action="Index">Overview</a><a asp-action="Users">Users</a><span>Roles</span><a asp-action="Clients">OAuth clients</a><a asp-action="Scopes">API scopes</a></div><div class="admin-panel"><div class="panel-header"><div><h2>Permission matrix</h2><p>Changes apply to newly issued or refreshed tokens.</p></div></div><div class="permission-groups">@foreach (var group in Model.Permissions.GroupBy(permission => permission.Value.Split('.')[0])) { <div class="permission-group"><h3>@group.Key</h3><div class="permission-chips">@foreach (var permission in group) { <span>@permission.DisplayName</span> }</div></div> }</div><div class="table-responsive permission-table"><table class="table align-middle mb-0"><thead><tr><th>Role</th>@foreach (var permission in Model.Permissions) { <th class="text-center">@permission.DisplayName</th> }</tr></thead><tbody>@foreach (var role in Model.Roles) { <tr><td><strong>@role.Name</strong></td>@foreach (var permission in Model.Permissions) { var enabled = role.Permissions.Contains(permission.Value); <td class="text-center"><form asp-action="SetRolePermission" asp-route-roleName="@role.Name" method="post" class="m-0"><input type="hidden" name="permission" value="@permission.Value" /><input type="checkbox" name="enabled" value="true" @(enabled ? "checked" : null) onchange="this.form.submit()" aria-label="@permission.DisplayName for @role.Name" /></form></td>}</tr>}</tbody></table></div></div></div>