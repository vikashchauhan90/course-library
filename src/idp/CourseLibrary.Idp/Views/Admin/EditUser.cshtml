@model EditUserViewModel
<div class="page-section"><h1>Edit user</h1><form method="post"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly"></div><label asp-for="FullName"></label><input asp-for="FullName" /><label asp-for="Email"></label><input asp-for="Email" /><label><input asp-for="IsLocked" /> Locked</label><h2 class="h5 mt-4">Roles</h2>@foreach (var role in Model.AvailableRoles) { <label class="d-block"><input type="checkbox" name="SelectedRoles" value="@role" @(Model.SelectedRoles.Contains(role, StringComparer.OrdinalIgnoreCase) ? "checked" : null) /> @role</label> }<button class="btn btn-primary mt-4" type="submit">Save changes</button></form></div>