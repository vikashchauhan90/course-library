@model ConsentViewModel
<h1>Authorize @Model.ClientName</h1>
<p>This application is requesting:</p>
<ul>@foreach (var scope in Model.Scopes) { <li>@scope</li> }</ul>
<form method="post">
	@foreach (var parameter in Context.Request.Query)
	{
		foreach (var value in parameter.Value)
		{
			<input type="hidden" name="@parameter.Key" value="@value" />
		}
	}
	<button name="decision" value="approve" type="submit">Approve</button>
	<button name="decision" value="deny" type="submit">Deny</button>
</form>